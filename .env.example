# Local Qwen 3.6-27B served by llama.cpp (default port 8080).
# Override only if your server runs elsewhere.
MORI_BASE_URL=http://localhost:8080/v1

# Gemini 2.0 Flash via Google AI Studio (free tier: 15 RPM, 1M tokens/day).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Notion DB push (optional — pipeline runs without it).
# Get a token by creating an Internal Integration at
# https://www.notion.so/my-integrations
NOTION_API_TOKEN=

# Where to publish. Set ONE of the two below:
#   NOTION_PARENT_PAGE_ID — first run will bootstrap a new database under this
#       page, then print the new database id to the log so you can move it
#       to NOTION_DATABASE_ID for subsequent runs.
#   NOTION_DATABASE_ID    — push pages directly into an existing database.
# Once both are set, NOTION_DATABASE_ID takes precedence.
NOTION_PARENT_PAGE_ID=
NOTION_DATABASE_ID=
