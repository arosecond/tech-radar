# =============================================================================
# tech-radar — environment variables
# =============================================================================
# Two reference deployment shapes are supported. Pick the section that matches
# your host. Variables left blank or unset cause the corresponding feature to
# be silently disabled (the pipeline still runs end-to-end).

# -----------------------------------------------------------------------------
# REQUIRED: local LLM endpoint (any OpenAI-compatible server)
# -----------------------------------------------------------------------------
# llama.cpp `server`  → http://localhost:8080/v1   (home rig, default)
# vLLM serve          → http://localhost:8000/v1   (company rig, ~2-3x faster
#                                                   on the same GPU/model)
LLM_BASE_URL=http://localhost:8080/v1

# Optional: only set if your endpoint requires auth (vLLM `--api-key=...`).
# llama.cpp's default config doesn't validate the key.
LLM_API_KEY=

# -----------------------------------------------------------------------------
# Gemini (optional — multi-provider routing)
# -----------------------------------------------------------------------------
# Free tier: ~10 RPM and a tight daily quota; not currently used by default
# routing. Set this only if you flip a stage's `provider:` to `gemini` in
# config/models.yaml. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Notion DB push (optional)
# -----------------------------------------------------------------------------
# Leave blank on the company host: paper content stays local-only.
# Fill in on the home host where Notion is the primary browse UI.
# https://www.notion.so/my-integrations
NOTION_API_TOKEN=

# Set exactly ONE of the two below:
#   NOTION_PARENT_PAGE_ID — first run bootstraps a new DB under this page and
#       prints the resulting database id; copy it into NOTION_DATABASE_ID for
#       subsequent runs.
#   NOTION_DATABASE_ID    — push pages directly into an existing database.
# If both are set, NOTION_DATABASE_ID wins.
NOTION_PARENT_PAGE_ID=
NOTION_DATABASE_ID=

# -----------------------------------------------------------------------------
# Slack notification (optional)
# -----------------------------------------------------------------------------
# Leave blank on the company host: don't post run summaries to a public service.
# Fill in on the home host with an Incoming Webhook URL.
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# OpenAlex polite-pool identification (optional)
# -----------------------------------------------------------------------------
# Sets the User-Agent so OpenAlex routes requests to the polite pool with the
# higher per-day quota. Leave blank for anonymous (still works, lower priority).
OPENALEX_MAILTO=

# =============================================================================
# Quick reference: company vs home presets
# =============================================================================
# Company (Ubuntu, vLLM, local-only):
#   LLM_BASE_URL=http://localhost:8000/v1
#   NOTION_API_TOKEN=          ← empty
#   SLACK_WEBHOOK_URL=         ← empty
#
# Home (Windows, llama.cpp, full publishing):
#   LLM_BASE_URL=http://localhost:8080/v1
#   NOTION_API_TOKEN=ntn_...
#   NOTION_DATABASE_ID=...
#   SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
